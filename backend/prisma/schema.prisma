// Prisma schema for the task management application.
//
// SQLite is used so the project runs with no external services. SQLite does not
// support native enums, so `status` is a String that is validated at the API
// boundary (see src/modules/tasks/task.schema.ts). Swapping to PostgreSQL is a
// provider change here plus a fresh migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("TODO")
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
}
