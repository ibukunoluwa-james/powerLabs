# Port the Express API listens on
PORT=4000

# Node environment: development | test | production
NODE_ENV=development

# Prisma connection string. SQLite by default - the file is created by `prisma migrate`.
DATABASE_URL="file:./dev.db"

# Comma-separated list of origins allowed to call the API (the Next.js frontend)
CORS_ORIGIN=http://localhost:3000
